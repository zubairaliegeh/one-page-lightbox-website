/* Gallery Styles */
.gallery-container {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
  justify-content: center;
}

.lightbox-trigger {
  width: 250px;
  height: auto;
  cursor: pointer;
  transition: transform 0.2s ease;
  border-radius: 8px;
}

.lightbox-trigger:hover {
  transform: scale(1.05);
}

/* Modal / Lightbox Overlay */
.modal {
  display: none; 
  position: fixed; 
  z-index: 1000; 
  left: 0;
  top: 0;
  width: 100%; 
  height: 100%; 
  background-color: rgba(0, 0, 0, 0.85); 
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

.modal-content {
  max-width: 80%;
  max-height: 80%;
  border-radius: 8px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.5);
}

#caption {
  margin-top: 15px;
  color: #fff;
  font-size: 1.1rem;
}

.close-btn {
  position: absolute;
  top: 20px;
  right: 35px;
  color: #fff;
  font-size: 40px;
  font-weight: bold;
  cursor: pointer;
}

.close-btn:hover {
  color: #bbb;
}
