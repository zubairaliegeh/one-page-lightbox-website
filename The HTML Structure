<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>One-Page Lightbox Gallery</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <h1>My Photo Gallery</h1>
    
    <!-- Gallery Grid -->
    <div class="gallery">
        <img src="img1.jpg" alt="Description 1" class="gallery-img">
        <img src="img2.jpg" alt="Description 2" class="gallery-img">
        <img src="img3.jpg" alt="Description 3" class="gallery-img">
    </div>

    <!-- The Lightbox Modal (Hidden by default) -->
    <div id="lightbox" class="modal">
        <span class="close">&times;</span>
        <img class="modal-content" id="lightbox-img">
        <div id="caption"></div>
    </div>

    <script href="script.js"></script>
</body>
</html>
